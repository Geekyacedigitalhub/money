# Copy to deploy/.env and fill in.

# The hostname you will open. DNS must point at this server first.
DOMAIN=bot.geekyacedigitalhub.com
PUBLIC_URL=https://bot.geekyacedigitalhub.com

# Basic auth for the whole site (protects your API credits).
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
AUTH_USER=ace
BASIC_AUTH_HASH=$2a$14$replace_with_your_own_hash
